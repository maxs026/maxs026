# Copiez ce fichier en « .env » et remplissez-le. Ne commitez jamais .env.

# Jeton du bot : portail développeur > Bot > Reset Token. SECRET.
DISCORD_TOKEN=

# Identifiant de l'application : portail développeur > General Information > Application ID.
DISCORD_CLIENT_ID=

# Facultatif : identifiant d'un serveur de test. S'il est renseigné, `npm run deploy-commands`
# enregistre les commandes sur ce serveur uniquement (effet immédiat). Laisser vide = commandes globales.
DISCORD_GUILD_ID=

# Chemin du fichier SQLite (doit être sur un stockage persistant en production).
DATABASE_PATH=./data/bot.sqlite

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
